# Where the contact form sends its messages (a form service endpoint, e.g. https://formspree.io/f/xxxxxxxx).
# Copy this file to .env and fill it in. Leave empty and the form opens the visitor's e-mail app instead.
PUBLIC_CONTACT_ENDPOINT=

# Only needed by some services (e.g. Web3Forms access key). Safe to leave empty otherwise.
PUBLIC_CONTACT_KEY=
